# Copy to .env and adjust. The server reads these on startup (Rule 3: UTC everywhere,
# Rule 7: SQLx). Never commit a real .env (see .gitignore).

# ---- API server ----
SERVER_HOST=0.0.0.0
# 9000 by default. (Desktop app runs on :3000, admin dashboard on :3001.)
SERVER_PORT=9000
# Production: keep at info. Use server=debug only for local troubleshooting (SEC-21).
RUST_LOG=info,server=info,sqlx=warn
# CORS: exact browser origins allowed to call the API (comma-separated, no
# wildcard — SEC-02). Set to your deployed dashboard origin(s) in production.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002
# Auth rate limiting (SEC-08): max requests per window per client IP on /auth/*.
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECS=60
# Trust the reverse proxy's X-Real-IP for client identity (RA-01). Keep true
# when behind nginx (default); set false only if the API is directly exposed.
RATE_LIMIT_TRUST_PROXY=true

# ---- PostgreSQL (server source of truth) ----
# LOCAL DEV (matches docker-compose.yml `--profile local` credentials):
DATABASE_URL=postgres://timetracker:timetracker@localhost:5432/timetracker
#
# PRODUCTION (managed DB, e.g. Supabase): use the SESSION-mode pooler connection
# string and require SSL. Do NOT use the transaction pooler (port 6543) — it does
# not support prepared statements and SQLx will fail. Format:
#   DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MAX_CONNECTIONS=10

# ---- Object storage: MinIO (local) / Cloudflare R2 (production) ----
# Rule 5: server stores only metadata; bytes live in R2/MinIO.
# MinIO's S3 API is published on :9100 (host :9000 is the API server).
S3_ENDPOINT=http://localhost:9100
S3_REGION=us-east-1
S3_BUCKET=screenshots
# REQUIRED in production: real R2/S3 keys. The server refuses the well-known
# 'minioadmin' default and won't start without credentials (SEC-03).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Local MinIO dev only: set to true to allow minioadmin/minioadmin. Default is
# false so a copied .env fails safe rather than silently using the default keys.
S3_ALLOW_INSECURE_DEFAULTS=false
S3_FORCE_PATH_STYLE=true

# ---- Auth (Rule 6) ----
# REQUIRED: >=32 chars of high-entropy random data. Generate with:
#   openssl rand -base64 48
# The server refuses to start on a short or placeholder value (SEC-07).
JWT_ACCESS_SECRET=
# Access-token lifetime (seconds). Kept short and capped at 3600 (SEC-18): a
# stateless token can't be revoked before it expires. Default 5 minutes.
JWT_ACCESS_TTL_SECONDS=300
JWT_REFRESH_TTL_SECONDS=2592000

# ---- Linear integration (STEP 8) ----
# Server-side ONLY (never sent to clients). Create a Personal API key at
# Linear → Settings → Security & access → Personal API keys. Leave empty to
# disable the integration (the /me/tickets endpoints return a clear error).
LINEAR_API_KEY=

# ---- Ticket access requests (email approval) ----
# Public base URL used in approve/reject links emailed to ticket owners.
PUBLIC_BASE_URL=http://localhost:9000
# SMTP for approval emails. Leave SMTP_HOST empty to run in "log mode" — the
# server logs the email + approve/reject links instead of sending.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=timetracker@localhost

# ---- Vision AI: screenshot analyzer ----
# Anthropic API key (server-side ONLY, never sent to clients). Create at
# https://console.anthropic.com/. Leave empty to disable analysis (the
# /admin/users/:id/analyze endpoint returns a clear "not configured" error).
ANTHROPIC_API_KEY=
# Override the model if needed (defaults to claude-haiku-4-5-20251001).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ---- Admin dashboard ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:9000
