{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TimeTracker",
  "version": "0.1.20",
  "identifier": "com.timetracker.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter desktop build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TimeTracker",
        "width": 1100,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "app", "dmg", "deb", "rpm", "appimage"],
    "category": "Productivity",
    "shortDescription": "Employee time tracking",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdFQjNDNEUzRUU5NzQ3MzcKUldRM1I1ZnU0OFN6ZnFMMGlYeDdjMWYzYjI4MUd0NktxZGZ2VmxtY3VualkzdXcweU01cEhBbzEK",
      "endpoints": [
        "https://github.com/shlok-1006/TimeTracker-Download/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
